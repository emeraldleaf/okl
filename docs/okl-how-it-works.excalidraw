      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "text": "okl record --type Defect --scope org \\\n  --tags security \\\n  --title \"ownership predicate missing\" \\\n  --symptom \"fetch by id, no owner in WHERE\" \\\n  --fix \"add caller id to WHERE; 404 on no match\"",
      "originalText": "okl record --type Defect --scope org \\\n  --tags security \\\n  --title \"ownership predicate missing\" \\\n  --symptom \"fetch by id, no owner in WHERE\" \\\n  --fix \"add caller id to WHERE; 404 on no match\""
    },
