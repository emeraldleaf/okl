      "seed": 688953,
      "version": 1,
      "versionNonce": 9111423,
      "type": "text",
      "x": 1400,
      "y": 1186.77,
      "width": 302.68,
      "height": 129.38,
      "strokeColor": "#0f172a",
      "fontSize": 11.5,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "text": "briefed 4–8% against a baseline of 33–50%\nthree runs, n=24 each, 0% harness failures\nreceipts: ab-20260830-0003 · ab-20260901-0133\n          ab-20260901-1238\n\nThe baseline arm receives no briefing and never\nchanged, yet moved 17 points across those runs.\nThat is the noise floor: the gap survives it,\ndifferences inside it are not interpretable.",
      "originalText": "briefed 4–8% against a baseline of 33–50%\nthree runs, n=24 each, 0% harness failures\nreceipts: ab-20260830-0003 · ab-20260901-0133\n          ab-20260901-1238\n\nThe baseline arm receives no briefing and never\nchanged, yet moved 17 points across those runs.\nThat is the noise floor: the gap survives it,\ndifferences inside it are not interpretable.",
      "id": "el87"
    }
