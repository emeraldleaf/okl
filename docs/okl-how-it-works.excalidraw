      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "text": "okl drift --gate is a mechanical grader with no stake\nin the claim. Not a warning in a file nobody opens.",
      "originalText": "okl drift --gate is a mechanical grader with no stake\nin the claim. Not a warning in a file nobody opens.",
