      "strokeColor": "#0f172a",
      "fontSize": 11.5,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "text": "okl verify <id> --run \"pytest -q\" --expect \"passed\"\nruns the check, reads the real outcome, and requires\nthe positive signal — exit 0 cannot self-certify.\nCommand and result are stored on the record.",
      "originalText": "okl verify <id> --run \"pytest -q\" --expect \"passed\"\nruns the check, reads the real outcome, and requires\nthe positive signal — exit 0 cannot self-certify.\nCommand and result are stored on the record.",
      "id": "el53"
    },
