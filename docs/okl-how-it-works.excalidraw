      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "text": "A STAMP IS EVIDENCE, NEVER A CLAIM",
      "originalText": "A STAMP IS EVIDENCE, NEVER A CLAIM",
      "id": "el52"
    },
    {
      "angle": 0,
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
