      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "text": "the last commit touching those paths, against the\ntimestamp of the record's last verification. Code\nnewer than the stamp means the rule may now be\ndescribing something that has already changed.",
      "originalText": "the last commit touching those paths, against the\ntimestamp of the record's last verification. Code\nnewer than the stamp means the rule may now be\ndescribing something that has already changed.",
      "id": "el50"
