   "text": "\"trust me\" \u2014 a verified flag with no evidence.\nAllowed only when importing historical\nreceipts; live verification refuses it.",
   "fontSize": 11.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
