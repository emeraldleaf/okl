   "groupIds": [],
   "frameId": null,
   "updated": 1776053089759,
   "link": null,
   "locked": false,
   "text": "the grader is usually `ls`, not an LLM \u00b7 verify at decision boundaries, not every micro-step \u00b7 a step saying \"done\" and the work being done are different facts",
   "fontSize": 12.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
