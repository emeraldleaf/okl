+def test_the_report_dict_survives_a_yaml_round_trip():
+    """The report holds only plain values, so a YAML dump and load gives back the same dict."""
+    import yaml
+    from okl.store import Store
+    s = Store("sqlite:///:memory:")
+    r = recap.report(s, "r", str(Path(__file__).parent), since_ms=0, now_ms=10_000)
+    assert yaml.safe_load(yaml.safe_dump(r)) == r
+    s.close()
