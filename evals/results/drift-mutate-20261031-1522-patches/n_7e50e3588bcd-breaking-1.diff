+def test_hygiene_findings_are_stable_across_a_yaml_round_trip():
+    """Records loaded from a YAML dump give the same findings as the original dicts."""
+    import yaml
+    recs = [{"key": k, "type": "Rule", "title": k, "scope": "org"} for k in ("a", "b", "c")]
