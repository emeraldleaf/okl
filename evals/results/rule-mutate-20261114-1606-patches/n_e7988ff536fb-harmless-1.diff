+def test_the_command_refuses_a_config_it_cannot_parse(repo, capsys):
+    """A config that is not JSON exits 2 with the reason on stderr, stdout empty, file untouched."""
+    path = repo / ".okl" / "config.json"
+    path.write_text("{not json")
+    assert main(["standing"]) == 2
+    captured = capsys.readouterr()
+    assert "could not be read" in captured.err
+    assert captured.out == ""
+    assert path.read_text() == "{not json"
+
