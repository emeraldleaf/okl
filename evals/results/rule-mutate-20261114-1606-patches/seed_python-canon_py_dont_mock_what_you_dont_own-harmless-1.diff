+def test_rerank_refuses_a_score_list_of_the_wrong_length(store, monkeypatch):
+    """A model that returns fewer scores than records is reported as unavailable, not a bare zip error."""
+    class Short:
+        def rerank(self, query: str, documents: list[str]) -> list[float]:
+            return [1.0]
+    monkeypatch.setattr(rerank, "load_model", lambda *a, **k: Short())
+    nodes = [store.get_node(core.record(store, type="Rule", title=t, scope="org")) for t in ("a b", "c d")]
+    with pytest.raises(rerank.RerankUnavailableError, match="1 scores for 2 records"):
+        rerank.rerank("task", nodes)
