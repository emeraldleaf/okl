+def _lines(text: str) -> Counter[str]:
+    """The non-blank, trimmed lines of `text`, counted: a diagram is the same text however its
+    elements are ordered or wrapped."""
+    return Counter(ln.strip() for ln in text.splitlines() if ln.strip())
+
+
+def render_text(svg: str) -> str:
+    """The text of every <text> element of an exported .svg render, one per line."""
+    root = ET.fromstring(svg)
+    return "\n".join("".join(e.itertext()) for e in root.iter() if e.tag.rsplit("}", 1)[-1] == "text")
+
+
+def stale(source_text: str, svg: str) -> list[str]:
+    """How the render's text differs from the source's: lines only the source has (the render
+    was never re-exported) and lines only the render has (it shows what the source dropped)."""
+    try:
+        drawn = _lines(render_text(svg))
+    except ET.ParseError as e:
+        return [f"the render is not valid SVG: {e}"]
+    wanted = _lines(source_text)
+    return ([f"render lacks text the source has: {ln!r}" for ln in sorted((wanted - drawn))]
+            + [f"render shows text the source lacks: {ln!r}" for ln in sorted((drawn - wanted))])
+
+
 def _tracked(path: str, files: set[str]) -> bool:
