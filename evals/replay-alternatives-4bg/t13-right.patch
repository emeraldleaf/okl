diff --git a/src/okl/client.py b/src/okl/client.py
index f455634..62dc56c 100644
--- a/src/okl/client.py
+++ b/src/okl/client.py
@@ -258,6 +258,12 @@ class Client:
         if kwargs.get("repo") is None:
             kwargs["repo"] = self.repo
         if self.mode == "remote":
+            # The service's request model takes these three as true or false, never null (a
+            # null is a 422 that fails every record), where core.record reads None as "not
+            # given": an agent tool that passes `replace=None` for "not asked" means False.
+            for flag in ("replace", "verified", "keep_verification"):
+                if flag in kwargs:
+                    kwargs[flag] = bool(kwargs[flag])
             return self._post("/record", kwargs)["id"]
         return core.record(self._local_store(), **kwargs)
 
