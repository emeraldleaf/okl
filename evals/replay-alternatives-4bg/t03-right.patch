+def validate_snapshot(snap: Any) -> None:
+    """Raise ValueError, naming the first fault, unless `snap` has the shape drift reads.
+
+    The file is hand-editable and a bad merge can leave anything in it; a gate that reads it
+    must refuse it as unreadable rather than crash on it. Each rule needs the fields
+    nodes_from_snapshot indexes, of the types the stamp check does arithmetic or matching on.
+    """
+    if not isinstance(snap, dict):
+        raise ValueError("the snapshot is not a JSON object")
+    rules = snap.get("rules", [])
+    if not isinstance(rules, list):
+        raise ValueError(f"`rules` must be a list of entries, not {type(rules).__name__}")
+    for i, r in enumerate(rules):
+        if not isinstance(r, dict):
+            raise ValueError(f"rules[{i}] must be an object, not {type(r).__name__}")
+        for key in ("id", "title", "scope"):
+            if not isinstance(r.get(key), str):
+                raise ValueError(f"rules[{i}] needs a text `{key}`")
+        if not isinstance(r.get("files"), str):
+            raise ValueError(f"rules[{i}] needs `files` as the text of its comma-separated globs")
+        if r.get("type") is not None and not isinstance(r["type"], str):
+            raise ValueError(f"rules[{i}] `type` must be text or null")
+        at = r.get("verified_at")
+        if at is not None and (not isinstance(at, int) or isinstance(at, bool)):
+            raise ValueError(f"rules[{i}] `verified_at` must be a millisecond timestamp or null")
+        if r.get("verified_by") is not None and not isinstance(r["verified_by"], str):
+            raise ValueError(f"rules[{i}] `verified_by` must be text or null")
+
+
