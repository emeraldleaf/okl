+    def local_store_url(self) -> str | None:
+        """The URL of the local store this client would open, or None when none is named.
+
+        The one place that decides it, so a caller asking whether the store exists agrees with
+        the one that opens it. OKL_DATABASE_URL wins when set (an empty value is unset, as
+        `configured` reads it); otherwise the store lives next to the config.
+        """
+        url = os.environ.get("OKL_DATABASE_URL")
+        if url:
+            return url
+        cfg = _find_config()
+        return f"sqlite:///{cfg.parent / 'okl.db'}" if cfg is not None else None
