+def test_status_and_stop_wait_for_a_server_busy_with_a_longer_request(monkeypatch, capsys):
+    """The server answers one connection at a time. Behind a request longer than a prompt's
+    TIMEOUT_S (an index batch), `okl warm status` said not running and `okl warm stop`, which the
+    server took and obeyed, said none had answered (#320)."""
+    from okl.cli import main
+
+    busy_s = warm.TIMEOUT_S * 4
+    path = Path(tempfile.mkdtemp(prefix="okl", dir="/tmp")) / "w.sock"
+    monkeypatch.setenv("OKL_WARM_SOCKET", str(path))
+
+    def slow_docs(texts, kind):
+        if kind == "doc":
+            time.sleep(busy_s)
+        return _stub(texts, kind)
+
+    monkeypatch.setattr(warm, "load_model", lambda: slow_docs)
+    server = threading.Thread(target=warm.serve, kwargs={"idle_exit_s": 30}, daemon=True)
+    server.start()
+    deadline = time.monotonic() + 5
+    while warm.ping() is None and time.monotonic() < deadline:
+        time.sleep(0.05)
+
+    def keep_busy():
+        warm.embed(["a lesson"], "doc", timeout=30)
+
+    def busy_now():
+        t = threading.Thread(target=keep_busy, daemon=True)
+        t.start()
+        time.sleep(0.1)   # the batch is being embedded
+        return t
+
+    t = busy_now()
+    assert main(["warm", "status"]) == 0
+    assert "running" in capsys.readouterr().out
+    t.join(timeout=10)
+
+    t = busy_now()
+    main(["warm", "stop"])
+    assert capsys.readouterr().out.startswith("stopped")
+    t.join(timeout=10)
+    server.join(timeout=10)
+    assert not server.is_alive()
+    warm.resume()
+
+
