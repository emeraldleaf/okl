+def _refuse_symlink(path: Path) -> bool:
+    """True, having said why, when `path` is a symbolic link: a cloned repo can plant one
+    where okl writes, and an ordinary write follows it out of the repo."""
+    if not path.is_symlink():
+        return False
+    print(f"! refusing to write {path}: it is a symbolic link (to {path.readlink()}); okl "
+          "writes only inside this repository.")
+    return True
+
