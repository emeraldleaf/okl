     assert new["decision"] == "tiered" and "decision_unavailable" not in new
 
 
+def test_a_service_that_refuses_tiered_is_asked_for_calibrated(monkeypatch):
+    """A service that knows `decision` but only floor and calibrated answers "tiered" with a
+    422. Every check, the prompt hook's included, failed closed against it; the client asks
+    again with calibrated and says so. Driven through the real client against such an app."""
+    import io
+    from typing import Literal
+    from urllib.error import HTTPError
+    from urllib.parse import urlsplit
+
+    pytest.importorskip("fastapi")
+    pytest.importorskip("httpx")
+    from fastapi import FastAPI
+    from fastapi.testclient import TestClient
+    from pydantic import BaseModel
+
+    from okl.client import Client, OKLRejectedError
+
+    s = _store_with([{"title": "retry the uploader with backoff",
+                      "triggers": ["uploads to the bucket fail intermittently and the job gives up"]}])
+
+    class OldCheckReq(BaseModel):
+        repo: str
+        task: str
+        limit: int = 12
+        decision: Literal["floor", "calibrated"] = "calibrated"
+
+    old_app = FastAPI()
+
+    @old_app.post("/check")
+    def check(req: OldCheckReq) -> dict:
+        return core.check(s, req.repo, req.task, limit=req.limit, decision=req.decision)
+
+    api = TestClient(old_app)
+    sent: list[str] = []
+
+    class Reply(io.BytesIO):
+        def __enter__(self): return self
+        def __exit__(self, *exc): self.close()
+
+    def urlopen(req, timeout=None):
+        sent.append(json.loads(req.data)["decision"])
+        r = api.request(req.get_method(), urlsplit(req.full_url).path, content=req.data,
+                        headers=dict(req.header_items()))
+        if r.status_code >= 400:
+            raise HTTPError(req.full_url, r.status_code, r.reason_phrase, None, io.BytesIO(r.content))
+        return Reply(r.content)
+
+    monkeypatch.setattr("okl.client._req.urlopen", urlopen)
+    monkeypatch.setattr("okl.client.drift.annotate_briefing", lambda *a, **k: None)
+    monkeypatch.delenv("OKL_DECISION", raising=False)
+    c = Client(config={"repo": "r", "service_url": "http://old.invalid"})
+    res = c.check("the uploader job gives up when bucket uploads fail intermittently")
+    assert sent == ["tiered", "calibrated"]
+    assert core.briefed_ids(res) == ["r0"]
+    assert res["decision"] == "calibrated" and "upgrade the service" in res["decision_unavailable"]
+
+    # A refusal of something else is still a refusal, after the one retry.
+    with pytest.raises(OKLRejectedError):
+        Client(config={"repo": "r", "service_url": "http://old.invalid"}).check("x", limit="many")
+    s.close()
+
+
