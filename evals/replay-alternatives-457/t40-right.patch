+def _symlink_on_path(path: Path) -> Path | None:
+    """The first symbolic link among `path` and its parents below the repo root (the
+    working directory init runs in), or None.
+
+    A cloned repository can hold a symlink at any path okl writes (.claude/settings.json,
+    .mcp.json, a hook, the workflow) or a symlinked .claude/ itself, and an ordinary write
+    follows it out of the repo. A dangling link counts: writing through it creates its target.
+    """
+    root = Path.cwd()
+    p = path if path.is_absolute() else root / path
+    while p != root and p != p.parent:
+        if p.is_symlink():
+            return p
+        p = p.parent
+    return None
+
+
+def _refuse_symlink(path: Path) -> bool:
+    """True, having said why, when writing `path` would follow a symlink out of the repo."""
+    link = _symlink_on_path(path)
+    if link is None:
+        return False
+    print(f"! refusing to write {path}: {link} is a symbolic link (to {link.readlink()}), and "
+          "okl writes only inside this repository. Replace the link with a real file or "
+          "directory, then re-run.")
+    return True
+
