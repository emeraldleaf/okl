+def test_init_and_uninstall_refuse_to_write_through_a_symlink(tmp_path):
+    """A cloned repo can hold a symlink where okl writes. init and uninstall refuse it, name
+    the link, and leave the outside target byte-identical (or, for a dangling link, absent)."""
+    import json
+    import sys
+
+    outside = tmp_path / "outside"; outside.mkdir()
+    env = {**os.environ, "HOME": str(tmp_path)}
+    env.pop("OKL_DATABASE_URL", None); env.pop("OKL_SERVICE_URL", None)
+
+    def okl(repo, *a):
+        return subprocess.run([sys.executable, "-m", "okl", *a], cwd=repo, env=env,
+                              capture_output=True, text=True)
+
+    # 1. A symlinked settings file, a dangling .mcp.json and a dangling workflow.
+    repo = tmp_path / "r1"; (repo / ".claude").mkdir(parents=True)
+    subprocess.run(["git", "init", "-q", str(repo)], check=True)
+    target = outside / "settings.json"
+    target.write_text(json.dumps({"model": "theirs"}))
+    before = target.read_bytes()
+    (repo / ".claude" / "settings.json").symlink_to(target)
+    (repo / ".mcp.json").symlink_to(outside / "mcp.json")
+    (repo / ".github").mkdir()
+    (repo / ".github" / "workflows").symlink_to(outside / "wf", target_is_directory=True)
+    r = okl(repo, "init", "--repo", "r")
+    assert r.returncode == 0, r.stdout + r.stderr
+    assert "refusing to write" in r.stdout and "symbolic link" in r.stdout
+    assert target.read_bytes() == before
+    assert not (outside / "mcp.json").exists() and not (outside / "wf").exists()
+    r = okl(repo, "init", "--uninstall")
+    assert target.read_bytes() == before, "uninstall rewrote a file outside the repo"
+
+    # 2. A symlinked .claude/ directory: nothing lands in, or is removed from, its target.
+    repo = tmp_path / "r2"; repo.mkdir()
+    subprocess.run(["git", "init", "-q", str(repo)], check=True)
+    claude_out = outside / "claude"; (claude_out / "hooks").mkdir(parents=True)
+    hook_src = (Path(__file__).resolve().parents[1] / "src" / "okl" / "scaffold" / "hooks"
+                / "stop-okl-encode.sh")
+    (claude_out / "hooks" / "stop-okl-encode.sh").write_text(hook_src.read_text())
+    (claude_out / "settings.json").write_text("{}")
+    (repo / ".claude").symlink_to(claude_out, target_is_directory=True)
+    snapshot = {p: p.read_bytes() for p in claude_out.rglob("*") if p.is_file()}
+    r = okl(repo, "init", "--repo", "r")
+    assert r.returncode == 0 and "refusing to write" in r.stdout, r.stdout + r.stderr
+    okl(repo, "init", "--uninstall")
+    assert {p: p.read_bytes() for p in claude_out.rglob("*") if p.is_file()} == snapshot
+
+
