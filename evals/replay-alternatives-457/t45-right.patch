diff --git a/tests/test_check_paths.py b/tests/test_check_paths.py
index 515438b..c7c3f2b 100644
--- a/tests/test_check_paths.py
+++ b/tests/test_check_paths.py
@@ -141,3 +141,25 @@ def test_okl_check_mcp_tool_takes_a_path(tmp_path, monkeypatch):
         assert asked.startswith("⚠️ okl_check needs a task, or a path"), asked
 
     asyncio.run(exercise())
+
+
+def test_a_check_of_no_files_is_refused_not_answered_clean(remote, tmp_path):
+    """Client.check with paths=[] and the service's /check with "paths": [] answered a briefing
+    with no lessons: a check of no files read as a clean one. Refused on every path: core, the
+    local and the remote client, the service, and a list whose every path is outside the repo."""
+    _record(remote.store, "scoped-orders", "src/orders.py")
+    with pytest.raises(ValueError, match="no paths to check"):
+        core.check_paths(remote.store, "r", [])
+    with pytest.raises(ValueError, match="no paths to check"):
+        Client().check("", paths=[])                                   # remote: no request sent
+    r = remote.api.post("/check", json={"repo": "r", "task": "", "paths": []})
+    assert r.status_code == 422 and "paths is empty" in r.json()["detail"]
+    with pytest.raises(ValueError, match="no path given is inside this repo"):
+        Client().check("", paths=["/etc/hosts"])
+
+    local = Client({"repo": "r"})
+    local.service_url = None
+    local._store = remote.store
+    with pytest.raises(ValueError, match="no paths to check"):
+        local.check("", paths=[])
+    assert [x["id"] for x in local.check("", paths=["src/orders.py"])["rules"]] == ["scoped-orders"]
