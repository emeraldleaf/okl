+def test_the_asgi_entrypoint_refuses_to_serve_without_a_token(monkeypatch):
+    """`uvicorn okl.service:app` never passes through okl serve's refusal, so the attribute it
+    imports fails closed itself: no token, or an empty one, builds no app, and the refusal
+    names the opt-in; OKL_ALLOW_NO_TOKEN=1 or a token builds it (#371)."""
+    pytest.importorskip("fastapi")
+    pytest.importorskip("httpx")
+    from fastapi.testclient import TestClient
+
+    import okl.service as svc
+
+    monkeypatch.setenv("OKL_DATABASE_URL", "sqlite:///:memory:")
+    monkeypatch.delenv("OKL_ALLOW_NO_TOKEN", raising=False)
+    for value in (None, ""):
+        monkeypatch.setattr(svc, "_app", None)
+        if value is None:
+            monkeypatch.delenv("OKL_TOKEN", raising=False)
+        else:
+            monkeypatch.setenv("OKL_TOKEN", value)
+        with pytest.raises(RuntimeError, match="OKL_ALLOW_NO_TOKEN=1"):
+            svc.app  # noqa: B018 - the attribute access is what an ASGI host does
+        assert svc._app is None
+
+    monkeypatch.setenv("OKL_ALLOW_NO_TOKEN", "1")
+    assert TestClient(svc.app).get("/nodes").status_code == 200
+    monkeypatch.setattr(svc, "_app", None)
+    monkeypatch.delenv("OKL_ALLOW_NO_TOKEN")
+    monkeypatch.setenv("OKL_TOKEN", "s3cret")
+    assert TestClient(svc.app).get("/nodes").status_code == 401
+
+
