diff --git a/src/okl/service.py b/src/okl/service.py
index 5c4af27..0827fbc 100644
--- a/src/okl/service.py
+++ b/src/okl/service.py
@@ -374,11 +374,37 @@ def __getattr__(name: str) -> FastAPI:
     if name == "app":
         global _app
         if _app is None:
+            refusal = _no_token_refusal()
+            if refusal:
+                raise RuntimeError(refusal)
             _app = create_app()
         return _app
     raise AttributeError(f"module {__name__!r} has no attribute {name!r}")
 
 
+# The explicit opt-in for serving `okl.service:app` with no token, as `--allow-no-token` is
+# for `okl serve`: a proxy in front authenticates every request, or only this machine can
+# reach the port.
+ALLOW_NO_TOKEN = "OKL_ALLOW_NO_TOKEN"  # noqa: S105 - the name of a switch, not a secret
+
+
+def _no_token_refusal() -> str | None:
+    """Why `okl.service:app` must not be built, or None when it may.
+
+    `okl serve` refuses to serve off loopback without OKL_TOKEN, but `uvicorn okl.service:app`,
+    the documented start for a process manager or a container, never passes through it, and
+    the app cannot see the address it is bound to. So the attribute every ASGI host imports
+    fails closed itself: no token (an empty one counts as none) and no explicit opt-in, no app
+    (#371).
+    """
+    if os.environ.get("OKL_TOKEN") or os.environ.get(ALLOW_NO_TOKEN) == "1":
+        return None
+    return ("OKL: refusing to build okl.service:app without OKL_TOKEN: every route, GET /nodes "
+            "included, would be open to anyone who can reach the port. Set OKL_TOKEN, or set "
+            f"{ALLOW_NO_TOKEN}=1 when a proxy in front authenticates or only this machine can "
+            "reach it (docs/DEPLOY.md §2).")
+
+
