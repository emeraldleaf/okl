+def test_doctor_reports_an_unreadable_store_of_any_backend_without_a_traceback(tmp_path, monkeypatch, capsys):
+    """A corrupt SQLite file (sqlite3's DatabaseError) or a Postgres store that is down
+    (psycopg's OperationalError) is a store that could not be read: doctor says so and keeps
+    its 0-or-1 contract, instead of ending in a traceback with exit 1."""
+    import subprocess
+
+    from okl.cli import main
+    from okl.client import Client
+    monkeypatch.setenv("HOME", str(tmp_path))
+    monkeypatch.chdir(tmp_path)
+    subprocess.run(["git", "init", "-q", "."], check=True)
+    assert main(["init", "--repo", "r", "--no-claude", "--no-seed", "--no-ci", "--interests", "python"]) == 0
+    capsys.readouterr()
+
+    # A corrupt store file, read for real.
+    (tmp_path / ".okl" / "okl.db").write_bytes(b"this is not a sqlite database" * 100)
+    assert main(["doctor"]) in (0, 1)
+    out = capsys.readouterr().out
+    assert "the store could not be read" in out, out
+
+    # A Postgres store that is down: psycopg's errors share no base with okl's or OSError.
+    class OperationalError(Exception):
+        pass
+
+    def down(self):
+        raise OperationalError("connection to server at 10.0.0.5 port 5432 failed")
+    monkeypatch.setattr(Client, "all_nodes", down)
+    assert main(["doctor"]) in (0, 1)
+    out = capsys.readouterr().out
+    assert "the store could not be read (connection to server" in out, out
+
+
