diff --git a/src/okl/service.py b/src/okl/service.py
index 5c4af27..448e597 100644
--- a/src/okl/service.py
+++ b/src/okl/service.py
@@ -374,6 +374,12 @@ def __getattr__(name: str) -> FastAPI:
     if name == "app":
         global _app
         if _app is None:
+            # `uvicorn okl.service:app` never passes through `okl serve`'s refusal, so the
+            # attribute an ASGI host imports refuses to serve with no token itself (#371).
+            if "OKL_TOKEN" not in os.environ and os.environ.get("OKL_ALLOW_NO_TOKEN") != "1":
+                raise RuntimeError(
+                    "OKL: refusing to build okl.service:app without OKL_TOKEN: every route would "
+                    "be open. Set OKL_TOKEN, or OKL_ALLOW_NO_TOKEN=1 when a proxy authenticates.")
             _app = create_app()
         return _app
     raise AttributeError(f"module {__name__!r} has no attribute {name!r}")
