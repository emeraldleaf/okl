+def test_doctor_refuses_an_unreadable_config_with_exit_2(tmp_path):
+    """A config doctor cannot read (not a JSON object, a folder, not JSON) is a refusal:
+    exit 2 and the reason on stderr, never a traceback whose exit 1 reads as a finding."""
+    import shutil
+    import subprocess
+    import sys
+
+    proj, home = tmp_path / "proj", tmp_path / "home"
+    (proj / ".okl").mkdir(parents=True); home.mkdir()
+    env = {**os.environ, "HOME": str(home), "USERPROFILE": str(home)}
+    env.pop("CLAUDE_CONFIG_DIR", None)
+    cfg = proj / ".okl" / "config.json"
+
+    def doctor():
+        return subprocess.run([sys.executable, "-m", "okl", "doctor"], capture_output=True,
+                              text=True, cwd=proj, env=env)
+
+    for content in ("[]", '"ci"', "{ not json"):
+        cfg.write_text(content)
+        r = doctor()
+        assert r.returncode == 2, (content, r.stdout, r.stderr)
+        assert "Traceback" not in r.stderr and "config.json" in r.stderr
+        assert r.stdout == ""
+    cfg.unlink(); cfg.mkdir()
+    r = doctor()
+    assert r.returncode == 2 and "Traceback" not in r.stderr, r.stderr
+    shutil.rmtree(cfg)
+    cfg.write_text('{"repo": "r", "ci": false}')
+    r = doctor()
+    assert r.returncode == 0 and "not gated in CI" in r.stdout, r.stdout + r.stderr
+
+
