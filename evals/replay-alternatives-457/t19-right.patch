--- a/tests/test_okl.py
+++ b/tests/test_okl.py
@@ -1773,3 +1773,27 @@ def test_empty_store_guidance_is_tailored_and_reaches_the_person_not_the_agent(t
     # 4. A populated store gets nothing.
     okl("record", "--type", "Rule", "--scope", "repo", "--title", "one lesson")
     assert "store is empty" not in okl("init", "--repo", "r").stdout
+
+
+def test_empty_store_guidance_quotes_the_pack_path_for_the_shell(tmp_path, monkeypatch):
+    """The advice is pasted into a shell, so a pack path holding a space or a quote
+    must come back as ONE argument naming that exact path."""
+    import shlex
+
+    import okl.cli as cli
+    from okl.client import Client
+
+    monkeypatch.delenv("OKL_DATABASE_URL", raising=False)
+    monkeypatch.delenv("OKL_SERVICE_URL", raising=False)
+    monkeypatch.chdir(tmp_path)
+    packs = tmp_path / "it's a dir; $(touch pwned) (x)"
+    packs.mkdir()
+    pack = packs / "react pack.json"
+    pack.write_text(json.dumps({"nodes": [{"title": "t", "tags": "react"}]}))
+    monkeypatch.setattr(cli, "_bundled_seed_dir", lambda: packs)
+
+    client = Client({"repo": "r", "interests": ["react"]})
+    lines = [ln for ln in cli._empty_store_guidance(client) if "okl seed " in ln]
+    assert lines, "the matching pack should be named"
+    argv = shlex.split(lines[0].rsplit("(", 1)[0])
+    assert argv == ["okl", "seed", str(pack)]
