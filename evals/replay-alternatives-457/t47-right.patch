diff --git a/tests/test_intake.py b/tests/test_intake.py
index 5854804..4452efc 100644
--- a/tests/test_intake.py
+++ b/tests/test_intake.py
@@ -145,3 +145,36 @@ def test_a_pr_gh_cannot_find_is_an_error_not_an_empty_list(monkeypatch, missing)
     monkeypatch.setattr(intake, "_gh", lambda *a: json.dumps(body))
     with pytest.raises(intake.IntakeError, match="no PR #9"):
         intake.fetch(9, "o/r")
+
+
+def test_a_store_that_cannot_be_read_is_not_a_store_that_covers_nothing(monkeypatch, capsys, tmp_path):
+    """_add_nearest returned silently when the store could not be read, so every finding read as
+    one no lesson covers, exactly as with a store that answered and holds none."""
+    from okl.cli import main
+    from okl.client import Client, OKLUnreachableError
+    monkeypatch.chdir(tmp_path)
+    monkeypatch.setenv("OKL_DATABASE_URL", f"sqlite:///{tmp_path / 'store.db'}")
+    monkeypatch.setattr(intake, "fetch", lambda n, repo=None: (PR, _files_of()))
+
+    # A store that answers and holds nothing: each finding says so, and nothing is unknown.
+    assert main(["intake", "pr", "7"]) == 0
+    answered = capsys.readouterr()
+    assert answered.out.count("a briefing on it shows no lesson yet") == 3
+    assert "unknown" not in answered.out + answered.err
+    assert main(["intake", "pr", "7", "--format", "json"]) == 0
+    data = json.loads(capsys.readouterr().out)
+    assert data["lessons_unchecked"] is None and [f["briefed"] for f in data["findings"]] == [[], [], []]
+
+    # A store that cannot be read: said, and no finding reads as covered by none.
+    def down(self, *a, **k):
+        raise OKLUnreachableError("OKL service unreachable at http://okl.test: connection refused")
+    monkeypatch.setattr(Client, "check", down)
+    assert main(["intake", "pr", "7"]) == 0
+    failed = capsys.readouterr()
+    assert "Not looked up, so unknown" in failed.out and "connection refused" in failed.out
+    assert "shows no lesson yet" not in failed.out
+    assert "unknown" in failed.err
+    assert main(["intake", "pr", "7", "--format", "json"]) == 0
+    data = json.loads(capsys.readouterr().out)
+    assert "could not be read" in data["lessons_unchecked"]
+    assert [f["briefed"] for f in data["findings"]] == [None, None, None]
