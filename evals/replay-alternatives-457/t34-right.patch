+"""ci/check-init-flags.py: a documented okl init flag must be a whole flag init knows."""
+import os
+import shutil
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def _run(tmp_path: Path, readme: str) -> subprocess.CompletedProcess[str]:
+    (tmp_path / "ci").mkdir(exist_ok=True)
+    shutil.copy(ROOT / "ci" / "check-init-flags.py", tmp_path / "ci" / "check-init-flags.py")
+    (tmp_path / "docs").mkdir(exist_ok=True)
+    (tmp_path / "docs" / "GETTING-STARTED.md").write_text("Nothing about setup here.\n")
+    (tmp_path / "README.md").write_text(readme)
+    env = {**os.environ, "PYTHONPATH": str(ROOT / "src")}
+    return subprocess.run([sys.executable, str(tmp_path / "ci" / "check-init-flags.py")],
+                          cwd=tmp_path, env=env, capture_output=True, text=True)
+
+
+@pytest.mark.parametrize("partial", ["--no-c", "--no", "--int", "--git"])
+def test_the_start_of_a_real_flag_is_not_a_flag(tmp_path, partial):
+    r = _run(tmp_path, f"Run `okl init {partial}` in the repo.\n")
+    assert r.returncode != 0, r.stdout
+    assert partial in r.stderr
+
+
+def test_whole_flags_pass(tmp_path):
+    r = _run(tmp_path, "Run `okl init --no-ci --interests python --no-claude` once.\n")
+    assert r.returncode == 0, r.stderr
