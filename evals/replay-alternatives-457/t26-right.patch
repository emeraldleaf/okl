         s.close()
 
 
+def test_the_second_tier_is_not_emptied_by_the_lessons_shown_in_full_at_a_small_limit():
+    """The floor's window used to be `limit` wide and the lessons shown in full were dropped
+    after it: at limit 1 the one slot was the shown lesson, so the second tier came back empty
+    while two other lessons matched. Widened by what is dropped, it names them."""
+    s = _store_with([
+        {"title": "retry the uploader with backoff",
+         "triggers": ["uploads to the bucket fail intermittently and the job gives up"]},
+        {"title": "uploader logging format"},
+        {"title": "bucket uploads checksum"},
+    ])
+    try:
+        task = "the uploader job gives up when bucket uploads fail intermittently"
+        full = core.check(s, repo="r", task=task)
+        everything = {e["id"] for e in full["also_matched"]}
+        assert everything == {"r1", "r2"}
+        for limit in (1, 2):
+            res = core.check(s, repo="r", task=task, limit=limit)
+            assert core.briefed_ids(res) == ["r0"]
+            also = [e["id"] for e in res["also_matched"]]
+            assert len(also) == limit and set(also) <= everything, (limit, also)
+    finally:
+        s.close()
+
+
+def test_the_second_tier_widens_past_a_window_the_shown_and_weak_lessons_fill():
+    """At limit 1 the floor's first window is three wide: the lesson shown in full and two
+    weak matches fill it, and a lesson the floor keeps ranks just below. Reading that window
+    whole is not enough; the fetch must be widened by the lessons it will drop."""
+    s = _store_with([
+        {"title": "retry the uploader with backoff",
+         "triggers": ["uploads to the bucket fail intermittently and the job gives up"]},
+        *({"title": f"w{i} note", "body": "intermittently intermittently"} for i in range(3)),
+        {"title": "sizing notes", "body": "when a bucket write may fail, size the queue " + "and more text " * 30},
+        *({"title": f"filler {i}", "body": "bucket stuff"} for i in range(10)),
+        *({"title": f"filler2 {i}", "body": "fail stuff"} for i in range(10)),
+    ])
+    try:
+        res = core.check(s, repo="r", limit=1,
+                         task="the uploader job gives up when bucket uploads fail intermittently")
+        assert core.briefed_ids(res) == ["r0"]
+        assert [e["id"] for e in res["also_matched"]] == ["r4"]
+    finally:
+        s.close()
+
+
 def test_a_second_tier_line_carries_the_first_sentence_of_the_fix_cut_at_a_word():
