+def test_the_server_pays_the_first_inference_before_it_listens(monkeypatch):
+    """The model's first inference is slow (ONNX allocates on it). Run before the socket is
+    bound, the first real request after a start answers within the time a prompt waits."""
+    path = Path(tempfile.mkdtemp(prefix="okl", dir="/tmp")) / "w.sock"
+    monkeypatch.setenv("OKL_WARM_SOCKET", str(path))
+    seen: list[bool] = []
+
+    def slow_first(texts, kind):
+        seen.append(path.exists())
+        if len(seen) == 1:
+            time.sleep(warm.TIMEOUT_S * 3)
+        return _stub(texts, kind)
+
+    monkeypatch.setattr(warm, "load_model", lambda: slow_first)
+    server = threading.Thread(target=warm.serve, kwargs={"idle_exit_s": 30}, daemon=True)
+    server.start()
+    deadline = time.monotonic() + 10
+    while warm.ping() is None and time.monotonic() < deadline:
+        time.sleep(0.05)
+    try:
+        assert seen and seen[0] is False, "the first inference ran after the socket was bound"
+        assert warm.ping()["loaded_s"] >= warm.TIMEOUT_S * 3
+        assert warm.embed(["a session token"], "query") == _stub(["a session token"], "query")
+    finally:
+        warm.stop()
+        server.join(timeout=5)
+
+
