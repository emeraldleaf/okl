     path = path or socket_path()
     started = time.perf_counter()
     encode = load_model()
+    # One throwaway inference before the socket exists. ONNX Runtime allocates its working
+    # memory on the first run, so without this the first prompt after every start paid that
+    # cost, ran past the half second a prompt waits, and was briefed without the model. Paid
+    # here, a prompt arriving while it runs finds no socket and is briefed at once, and
+    # `loaded_s` is the time until the server could answer within TIMEOUT_S.
+    encode(["warm up"], "query")
     loaded_s = time.perf_counter() - started
     path.parent.mkdir(parents=True, exist_ok=True)
