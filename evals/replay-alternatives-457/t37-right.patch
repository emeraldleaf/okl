+def _load(monkeypatch, name):
+    monkeypatch.setattr(sys, "path", list(sys.path))     # the scripts put evals/ on the path
+    spec = importlib.util.spec_from_file_location(name, HERE / "evals" / f"{name}.py")
+    mod = importlib.util.module_from_spec(spec)
+    monkeypatch.setitem(sys.modules, name, mod)
+    spec.loader.exec_module(mod)
+    return mod
+
+
+# {v} is the verdict the reply means, {w} an earlier one it replaces.
+REPLIES = [
+    ('Looking at {{the diff}} and set {{x}}: {{"verdict": "{v}"}}', True),
+    ('You asked for {{"verdict": "broken|intact|unsure"}}. Here it is: {{"verdict": "{v}"}}', True),
+    ('{{"verdict": "{v}", "why": "see the note"}}\nNote: the hunk at {{line 4}} is cosmetic.', True),
+    ('First I thought {{"verdict": "{w}"}} but on reflection {{"verdict": "{v}"}}', True),
+    ('```json\n{{"verdict": "{v}", "detail": {{"file": "a.py", "code": "if x: {{}}"}}}}\n```', True),
+    ("no json here at all", False),
+    ('{{"verdict": "probably"}}', False),
+]
+
+
+@pytest.mark.parametrize("reply, has", REPLIES)
+def test_a_judge_reply_is_read_wherever_its_verdict_is(monkeypatch, reply, has):
+    """A greedy match from the first { to the last } read prose braces, a quoted answer format,
+    a trailing note and two verdicts as no verdict; the last valid object is the answer."""
+    lc, dm = _load(monkeypatch, "lesson_census"), _load(monkeypatch, "drift_mutate")
+    got = lc.parse_verdict(reply.format(v="stale", w="current"))
+    assert (got or {}).get("verdict") == ("stale" if has else None)
+    assert dm.judged(reply.format(v="broken", w="intact")) == ("broken" if has else None)
