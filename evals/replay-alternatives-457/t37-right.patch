+def last_verdict(reply: str, allowed: tuple[str, ...] | frozenset[str]) -> dict | None:
+    """The last JSON object anywhere in a judge's reply whose "verdict" is one of `allowed`,
+    or None when there is none.
+
+    Each `{` is tried as the start of a JSON value, so prose with braces in it, a quoted answer
+    format (whose "verdict" is not an allowed value), a trailing note, or an object nested in
+    the verdict cannot hide it; of two verdicts the last is the answer. A greedy match from the
+    first `{` to the last `}` read every one of those replies as no verdict.
+    """
+    decoder = json.JSONDecoder()
+    found = None
+    for m in re.finditer(r"\{", reply):
+        try:
+            got, _end = decoder.raw_decode(reply, m.start())
+        except ValueError:
+            continue
+        if isinstance(got, dict) and got.get("verdict") in allowed:
+            found = got
+    return found
+
