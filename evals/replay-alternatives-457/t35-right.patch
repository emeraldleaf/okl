diff --git a/tests/test_bench_corpus.py b/tests/test_bench_corpus.py
new file mode 100644
index 0000000..56b2425
--- /dev/null
+++ b/tests/test_bench_corpus.py
@@ -0,0 +1,35 @@
+"""evals/bench/run.py builds its corpus in a throwaway store, whatever the shell exported."""
+import importlib.util
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def test_build_corpus_ignores_exported_storage_variables(tmp_path, monkeypatch):
+    from okl import core
+    from okl.store import Store
+
+    spec = importlib.util.spec_from_file_location("bench_run", ROOT / "evals" / "bench" / "run.py")
+    bench = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(bench)
+
+    real = tmp_path / "real.db"
+    s = Store(f"sqlite:///{real}")
+    core.record(s, id="mine", type="Rule", scope="org", title="a lesson the person wrote")
+    s.close()
+    monkeypatch.setenv("OKL_DATABASE_URL", f"sqlite:///{real}")
+    monkeypatch.setenv("OKL_SERVICE_URL", "http://shared.invalid")
+
+    def no_network(*a, **k):
+        raise AssertionError("the bench corpus reached a service")
+    monkeypatch.setattr("okl.client._req.urlopen", no_network)
+
+    corpus = bench.build_corpus(tmp_path / "corpus")
+
+    assert len(corpus.all_nodes()) > 50
+    assert corpus.get_node("mine") is None
+    s = Store(f"sqlite:///{real}")
+    assert [n.id for n in s.all_nodes()] == ["mine"], "a pack reached the real store"
+    s.close()
+    import os
+    assert os.environ["OKL_DATABASE_URL"] == f"sqlite:///{real}", "the caller's env is restored"
