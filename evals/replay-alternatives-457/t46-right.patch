+def test_only_the_install_step_reading_the_pin_counts(tmp_path, monkeypatch):
+    """A kept workflow reads the pin only when its okl install step does, in a command: a mention
+    in a comment, or in another step, said CI was pinned beside an install step that installs the
+    newest okl (0.11.0 review)."""
+    from okl.cli import install
+    monkeypatch.chdir(tmp_path)
+    (tmp_path / ".github" / "workflows").mkdir(parents=True)
+    shipped = install.WORKFLOW_SRC.read_text()
+    unpinned = "\n".join(ln for ln in shipped.splitlines() if "okl-version" not in ln) + "\n"
+    assert "pip install observed-knowledge-ledger" in unpinned
+
+    def reads(text: str) -> bool:
+        install.WORKFLOW.write_text(text)
+        return install._workflow_reads_pin()
+
+    assert reads(shipped)
+    assert not reads(unpinned)
+    # A YAML comment above the step, and a shell comment inside it.
+    assert not reads(unpinned.replace("      - name: Install okl\n",
+                                      "      # pinned by .github/okl-version\n      - name: Install okl\n"))
+    assert not reads(unpinned.replace("pip install observed-knowledge-ledger\n",
+                                      "pip install observed-knowledge-ledger  # see .github/okl-version\n"))
+    # Another step reads it; the install step still installs the newest release.
+    assert not reads(unpinned + "      - name: Show the pin\n        run: cat .github/okl-version\n")
+
+
