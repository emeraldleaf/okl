+
+def _run_blocks(workflow: str) -> list[str]:
+    """Each step's `run:` commands in a GitHub Actions workflow, comments dropped: an inline
+    `run: <command>`, or the lines of a `run: |` block (indented deeper than the key). No YAML
+    library, since okl has none as a dependency; this is the one shape workflows write."""
+    blocks: list[str] = []
+    lines = workflow.splitlines()
+    i = 0
+    while i < len(lines):
+        m = re.match(r"^(\s*)(?:-\s+)?run:\s*(.*)$", lines[i])
+        i += 1
+        if not m:
+            continue
+        indent, rest = len(m.group(1)), m.group(2).strip()
+        body: list[str] = []
+        if re.fullmatch(r"[|>][-+0-9]*(\s+#.*)?", rest):
+            while i < len(lines) and (not lines[i].strip()
+                                      or len(lines[i]) - len(lines[i].lstrip()) > indent):
+                body.append(lines[i])
+                i += 1
+        else:
+            body.append(rest)
+        commands = [re.sub(r"(^|\s)#.*$", "", ln).rstrip() for ln in body]
+        blocks.append("\n".join(c for c in commands if c.strip()))
+    return blocks
 
 
