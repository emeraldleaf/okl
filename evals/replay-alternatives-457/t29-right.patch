diff --git a/tests/test_retire.py b/tests/test_retire.py
index ee47a88..073694b 100644
--- a/tests/test_retire.py
+++ b/tests/test_retire.py
@@ -551,3 +551,33 @@ def test_mcp_retire_says_to_refresh_the_snapshot_when_the_lesson_governs_files(r
     plain = text(asyncio.run(_build().call_tool("okl_retire", {"id": "refund-new", "reason": "x"})))
     assert "okl export --drift" in governs, governs
     assert "okl export" not in plain, plain
+
+
+def test_dedup_compares_only_what_a_briefing_can_show(repo, capsys):
+    """A lesson superseded by its copy, or an obsolete one, is resolved: dedup reported each
+    such pair with exit 1. A retracted lesson is still briefed, so it is compared and marked."""
+    c = Client()
+
+    def lesson(i):
+        c.record(id=i, type="Rule", title="refunds post to the ledger before the charge",
+                 scope="repo", body="refund ledger ordering rule")
+
+    for i in ("a", "b", "c"):
+        lesson(i)
+    assert main(["retire", "b", "--by", "a", "--reason", "copy"]) == 0
+    assert main(["retire", "c", "--obsolete", "--reason", "gone"]) == 0
+    capsys.readouterr()
+    assert main(["dedup"]) == 0
+    out = capsys.readouterr().out
+    assert "OK" in out and "2 superseded or obsolete left out" in out
+
+    lesson("d")
+    capsys.readouterr()
+    assert main(["dedup"]) == 1
+    out = capsys.readouterr().out
+    assert "1 candidate pair(s)" in out and "[b]" not in out and "[c]" not in out
+
+    assert main(["retire", "d", "--reason", "wrong"]) == 0
+    capsys.readouterr()
+    assert main(["dedup"]) == 1
+    assert "[d] Rule · repo:r · retracted" in capsys.readouterr().out
