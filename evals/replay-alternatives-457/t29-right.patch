+    every = list(client.all_nodes())
+    nodes = [n for n in every if n.status not in core._UNBRIEFED]
+    retired = len(every) - len(nodes)
     store = client._local_store() if client.mode == "local" else None
     idf = core._idf(store) if store is not None else {}
 
