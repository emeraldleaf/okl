@@ -580,7 +580,13 @@ def cmd_dedup(args: argparse.Namespace) -> int:
     if not client.configured:
         print("OKL NOT CONFIGURED — run `okl init` here, or `okl connect <url>`.", file=sys.stderr)
         return 2
-    nodes = list(client.all_nodes())
+    # The set a briefing can show: a superseded lesson (a pack rename leaves one beside each
