     args = ap.parse_args()
-    before = {lid: dr.governs(rule) for lid, rule in dr.snapshot(BEFORE).items() if dr.governs(rule)}
+    # A revision git cannot resolve read as a snapshot with no lessons, so every lesson's files
+    # came out "cleared" and the receipt was written. Refused (exit 2) before anything runs,
+    # as is a revision whose committed snapshot holds no lessons: neither is a measurement.
+    if args.after.startswith("-") or not dr.git_ok("rev-parse", "--verify", "--quiet",
+                                                   f"{args.after}^{{commit}}"):
+        print(f"REFUSING: --after {args.after!r} is not a commit git can resolve here", file=sys.stderr)
+        return 2
     now = dr.snapshot(args.after)
+    if not now:
+        print(f"REFUSING: the snapshot at --after {args.after!r} holds no lessons "
+              "(no okl-drift.json there, or an empty one)", file=sys.stderr)
+        return 2
+    before = {lid: dr.governs(rule) for lid, rule in dr.snapshot(BEFORE).items() if dr.governs(rule)}
     after = {lid: dr.governs(now.get(lid) or {}) for lid in before}
     lists = {"before": before, "after": after}
     merges = count(dr.git("rev-list", "--first-parent", f"{SINCE}..{BEFORE}").split(), lists)
