+
+
+@pytest.mark.parametrize("rev", ["no-such-revision", "3af67a8x", "--all", "HEAD~999999"])
+def test_the_widen_cost_refuses_a_revision_git_cannot_resolve(monkeypatch, capsys, rev):
+    """§4ah: a mistyped --after read as a snapshot with no lessons, reported every lesson's
+    files as cleared and wrote a receipt. It is refused, with exit 2, and nothing is written."""
+    monkeypatch.setattr(sys, "path", list(sys.path))
+    spec = importlib.util.spec_from_file_location("drift_widen_cost", HERE / "evals" / "drift_widen_cost.py")
+    wc = importlib.util.module_from_spec(spec)
+    monkeypatch.setitem(sys.modules, "drift_widen_cost", wc)
+    spec.loader.exec_module(wc)
+    results = HERE / "evals" / "results"
+    before = set(results.iterdir())
+    monkeypatch.setattr(sys, "argv", ["drift_widen_cost.py", f"--after={rev}"])
+    assert wc.main() == 2
+    err = capsys.readouterr().err
+    assert "REFUSING" in err and rev in err
+    assert set(results.iterdir()) == before, "a refused run wrote a receipt"
