@@ -435,3 +435,21 @@ def test_each_side_of_an_event_reads_the_paths_its_snapshot_named(dr, tmp_path):
     assert kinds[(b0, b2)] == "no governed paths"
     got, left = dr.pairs(dr.snapshot("HEAD", bare), "HEAD", bare)
