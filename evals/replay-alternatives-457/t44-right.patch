diff --git a/tests/test_architecture.py b/tests/test_architecture.py
index 19db7db..a437e38 100644
--- a/tests/test_architecture.py
+++ b/tests/test_architecture.py
@@ -59,3 +59,20 @@ def test_the_name_check_fails_on_each_kind_of_name_the_code_lacks(tmp_path):
     for name in ("okl frobnicate", "--no-such-flag", "okl_teleport", "PreCompact",
                  "stop-okl-encode2.sh", "gates/ghost.yml", "UNVANISHED"):
         assert f"FAIL: {name}" in bad.stdout, (name, bad.stdout)
+
+
+def test_a_misspelt_or_invented_hook_event_is_read_and_fails(tmp_path):
+    """The check matched only a fixed list of event names, so an event the list did not hold,
+    misspelt or invented, was never looked at and passed. Every CamelCase word is a claim."""
+    def run(*texts: str) -> subprocess.CompletedProcess[str]:
+        p = tmp_path / f"d{len(list(tmp_path.iterdir()))}.excalidraw"
+        p.write_text(json.dumps({"type": "excalidraw", "elements": [
+            {"type": "text", "text": t} for t in texts]}))
+        return subprocess.run([sys.executable, str(CHECK), str(p)], capture_output=True,
+                              text=True, cwd=ROOT)
+
+    for wrong in ("UserPromtSubmit", "PostToolUsed", "PreCommit", "BeforePrompt"):
+        r = run("the hook on", wrong, "runs okl check")
+        assert r.returncode == 1 and f"FAIL: {wrong}" in r.stdout, (wrong, r.stdout)
+    ok = run("UserPromptSubmit", "PostToolUse", "Stop", "a GitHub Actions job")
+    assert ok.returncode == 0, ok.stdout + ok.stderr
