diff --git a/tests/test_okl.py b/tests/test_okl.py
index 76d207b..ec432c6 100644
--- a/tests/test_okl.py
+++ b/tests/test_okl.py
@@ -3390,3 +3390,53 @@ def test_the_suite_is_deaf_to_a_real_store_named_in_the_environment(store):
     a "throwaway" Client would land in the real store. Here it lands in a temp one."""
     import os
     assert all(v not in os.environ for v in ("OKL_DATABASE_URL", "OKL_SERVICE_URL", "OKL_TOKEN"))
+
+
+def test_check_unlogged_writes_no_briefing_row_locally_or_through_the_service(tmp_path, monkeypatch):
+    """A caller that briefs no agent (an eval, a pre-flight) asks for its check unlogged:
+    no briefing row lands in the store okl metric reads, whether the client is local or
+    goes through a service. A plain check still logs."""
+    import io
+    import urllib.request
+
+    from okl.client import Client
+
+    monkeypatch.chdir(tmp_path)
+    monkeypatch.delenv("OKL_BRIEFING_LOG", raising=False)
+    monkeypatch.setenv("OKL_DATABASE_URL", f"sqlite:///{tmp_path}/local.db")
+    local = Client({"repo": "r"})
+    s = local._local_store()
+    core.record(s, type="Rule", title="pin the decoder axes", scope="org")
+    local.check("decoder axes", log=False)
+    assert s.briefings() == []
+    local.check("decoder axes")
+    assert len(s.briefings()) == 1
+
+    pytest.importorskip("fastapi")
+    pytest.importorskip("httpx")
+    from fastapi.testclient import TestClient
+
+    from okl.service import create_app
+
+    svc = Store("sqlite:///:memory:")
+    core.record(svc, type="Rule", title="pin the decoder axes", scope="org")
+    http = TestClient(create_app(store=svc))
+
+    class _Resp(io.BytesIO):
+        status = 200
+        def __enter__(self): return self
+        def __exit__(self, *a): return False
+
+    def fake_urlopen(req, timeout=None):
+        path = req.full_url.split("svc.test", 1)[1]
+        r = http.post(path, content=req.data, headers=dict(req.header_items()))
+        assert r.status_code == 200, r.text
+        return _Resp(r.content)
+
+    monkeypatch.delenv("OKL_DATABASE_URL")
+    monkeypatch.setattr(urllib.request, "urlopen", fake_urlopen)
+    remote = Client({"repo": "r", "service_url": "http://svc.test"})
+    remote.check("decoder axes", log=False)
+    assert svc.briefings() == []
+    remote.check("decoder axes")
+    assert len(svc.briefings()) == 1
