diff --git a/tests/test_render_pipeline_seed.py b/tests/test_render_pipeline_seed.py
new file mode 100644
index 0000000..41f5bd0
--- /dev/null
+++ b/tests/test_render_pipeline_seed.py
@@ -0,0 +1,31 @@
+"""docs/render_pipeline_diagram.py seeds a throwaway store, never a configured service."""
+import importlib.util
+import json
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def test_the_trace_seeds_its_own_store_when_the_checkout_names_a_service(tmp_path, monkeypatch):
+    spec = importlib.util.spec_from_file_location("render_pipeline_diagram",
+                                                  ROOT / "docs" / "render_pipeline_diagram.py")
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+
+    # A checkout whose own config points at a service (here one that refuses every connection).
+    checkout = tmp_path / "checkout"
+    (checkout / "seed").mkdir(parents=True)
+    (checkout / "seed" / "tiny.json").write_text(json.dumps({"nodes": [
+        {"key": "k", "type": "Rule", "scope": "org", "repo": "x", "title": "pin the decoder axes"}]}))
+    (checkout / ".okl").mkdir()
+    (checkout / ".okl" / "config.json").write_text(
+        json.dumps({"repo": "okl", "service_url": "http://127.0.0.1:9"}))
+    monkeypatch.setattr(mod, "REPO", checkout)
+    monkeypatch.delenv("OKL_SERVICE_URL", raising=False)
+    monkeypatch.setenv("PYTHONPATH", str(ROOT / "src"))
+
+    trace_dir = tmp_path / "trace"; trace_dir.mkdir()
+    store = mod._seeded_store(str(trace_dir))
+
+    assert [n.id for n in store.all_nodes()] == ["seed:tiny:k"]
+    store.close()
