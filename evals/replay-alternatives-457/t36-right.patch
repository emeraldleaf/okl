diff --git a/tests/test_stem.py b/tests/test_stem.py
index 85f2570..115561b 100644
--- a/tests/test_stem.py
+++ b/tests/test_stem.py
@@ -88,3 +88,47 @@ def test_without_fts5_a_word_is_its_own_stem(monkeypatch):
     monkeypatch.setattr(decide.sqlite3, "connect", lambda *_a: NoFts())
     monkeypatch.setattr(decide, "_STEMS", {})
     assert decide.stems(["rotating"]) == {"rotating": "rotating"}
+
+
+def test_a_rebuild_that_fails_after_its_drop_leaves_the_old_index(tmp_path, monkeypatch):
+    """The rebuild is all or nothing: a failure after the DROP used to be committed with the
+    LIKE fallback, so the next open created an empty index in the right shape, never rebuilt
+    it, and search found no lesson."""
+    db = tmp_path / "okl.db"
+    monkeypatch.setattr(okl_store, "FTS_TOKENIZE", "unicode61")
+    s = Store(f"sqlite:///{db}")
+    nid = core.record(s, type="Rule", title="rotate the signing secret", scope="org")
+    s.close()
+
+    # A tokenizer this SQLite does not have: the CREATE after the DROP fails. A write in the
+    # same process afterwards must not commit the DROP either.
+    monkeypatch.setattr(okl_store, "FTS_TOKENIZE", "no_such_tokenizer")
+    s = Store(f"sqlite:///{db}")
+    other = core.record(s, type="Rule", title="pin the base image digest", scope="org")
+    s.close()
+
+    monkeypatch.setattr(okl_store, "FTS_TOKENIZE", "unicode61")
+    s = Store(f"sqlite:///{db}")
+    try:
+        assert [n.id for n in s.search("signing secret", limit=5)] == [nid]
+        assert [n.id for n in s.search("base image digest", limit=5)] == [other]
+    finally:
+        s.close()
+
+
+def test_an_index_left_empty_by_an_earlier_failed_rebuild_is_rebuilt(tmp_path, monkeypatch):
+    """A store an older okl already broke (an empty index in the right shape) heals on open."""
+    db = tmp_path / "okl.db"
+    monkeypatch.setattr(okl_store, "FTS_TOKENIZE", "unicode61")
+    s = Store(f"sqlite:///{db}")
+    nid = core.record(s, type="Rule", title="rotate the signing secret", scope="org")
+    s.close()
+    with contextlib.closing(sqlite3.connect(db)) as c:
+        c.execute("DELETE FROM node_fts")
+        c.commit()
+    s = Store(f"sqlite:///{db}")
+    try:
+        assert [n.id for n in s.search("signing secret", limit=5)] == [nid]
+        assert not s._impl._fts_stale()
+    finally:
+        s.close()
