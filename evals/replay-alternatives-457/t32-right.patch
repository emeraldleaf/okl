@@ -0,0 +1,45 @@
+"""evals/hybrid_grid.py must not print full-text results as the semantic arm's cells."""
+import json
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def _grid_dir(tmp_path: Path, vectors: bool) -> Path:
+    from okl import core, semantic
+    from okl.store import Store
+
+    (tmp_path / ".okl").mkdir()
+    (tmp_path / ".okl" / "config.json").write_text(json.dumps({"repo": "okl"}))
+    s = Store(f"sqlite:///{tmp_path / '.okl' / 'okl.db'}")
+    nid = core.record(s, type="Rule", scope="org", title="check object ownership on every id route")
+    if vectors:
+        s.put_embedding(nid, semantic.MODEL_ID, "h", semantic.pack([0.1] * 8))
+    s.close()
+    ev = tmp_path / "evals"; ev.mkdir()
+    (ev / "tasks.jsonl").write_text(json.dumps(
+        {"id": "idor_endpoint", "task": "add an orders route by id", "defect_node": nid}) + "\n")
+    (ev / "heldout_variants.json").write_text(json.dumps(
+        {"idor_endpoint": {"ticket": "orders by id", "paraphrase": "fetch one order", "bug-report": "see others' orders"}}))
+    (ev / "probe_prompts.json").write_text(json.dumps({"prompts": ["give me a doc for that"]}))
+    return tmp_path
+
+
+@pytest.mark.parametrize("vectors", [False, True], ids=["no vectors", "no cached model"])
+def test_the_grid_refuses_when_the_semantic_arm_falls_back(tmp_path, vectors):
+    cwd = _grid_dir(tmp_path, vectors)
+    env = {k: v for k, v in os.environ.items()
+           if k not in ("OKL_DATABASE_URL", "OKL_SERVICE_URL", "OKL_TOKEN")}
+    env["PYTHONPATH"] = str(ROOT / "src")
+    # An empty model cache: with vectors present, the model is what is missing.
+    env["HF_HOME"] = env["HF_HUB_CACHE"] = str(tmp_path / "empty-hf-cache")
+    r = subprocess.run([sys.executable, str(ROOT / "evals" / "hybrid_grid.py")], cwd=cwd, env=env,
+                       capture_output=True, text=True)
+    assert r.returncode == 2, r.stdout + r.stderr
+    assert "semantic arm did not run" in r.stderr
+    assert "rrf" not in r.stdout and "linear" not in r.stdout, r.stdout
