diff --git a/tests/test_probe_rephrase.py b/tests/test_probe_rephrase.py
new file mode 100644
index 0000000..c5a0bb0
--- /dev/null
+++ b/tests/test_probe_rephrase.py
@@ -0,0 +1,32 @@
+"""evals/probe_rephrase.py resolves each task's governing lesson before it prints a row."""
+import json
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def test_probe_refuses_a_governing_lesson_the_store_does_not_hold(tmp_path):
+    from okl import core
+    from okl.store import Store
+
+    (tmp_path / ".okl").mkdir()
+    (tmp_path / ".okl" / "config.json").write_text(json.dumps({"repo": "okl"}))
+    s = Store(f"sqlite:///{tmp_path / '.okl' / 'okl.db'}")
+    core.record(s, id="held", type="Rule", scope="org", title="check object ownership on every id route")
+    s.close()
+    (tmp_path / "evals").mkdir()
+    (tmp_path / "evals" / "tasks.jsonl").write_text("\n".join(json.dumps(t) for t in (
+        {"id": "idor_endpoint", "task": "add GET /orders/{id}", "defect_node": "held"},
+        {"id": "price_tamper", "task": "POST /orders with a price", "defect_node": "typo_id"},
+    )) + "\n")
+    env = {k: v for k, v in os.environ.items()
+           if k not in ("OKL_DATABASE_URL", "OKL_SERVICE_URL", "OKL_TOKEN")}
+    env["PYTHONPATH"] = str(ROOT / "src")
+    r = subprocess.run([sys.executable, str(ROOT / "evals" / "probe_rephrase.py")], cwd=tmp_path,
+                       env=env, capture_output=True, text=True)
+    assert r.returncode == 2, r.stdout + r.stderr
+    assert "typo_id" in r.stderr and "Traceback" not in r.stderr
+    assert "idor_endpoint" not in r.stdout, "no row may print before the references resolve"
