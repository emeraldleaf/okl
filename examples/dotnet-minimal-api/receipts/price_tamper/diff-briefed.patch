+app.MapPost("/orders", (HttpContext ctx, CreateOrderRequest req) =>
+{
+    var user = Auth.CurrentUser(ctx);
+    if (user is null) return Results.Unauthorized();
+
+    // Price is always sourced from the catalog — never from the client body.
+    if (!Store.Products.TryGetValue(req.Item, out var unitPrice))
+        return Results.NotFound();
+
+    var id = Store.Orders.Keys.DefaultIfEmpty(0).Max() + 1;
+    var order = new Order(id, user, req.Item, req.Quantity, unitPrice);
+    Store.Orders[id] = order;
+    return Results.Created($"/orders/{id}", order);
+});
+
 app.Run();
 
 public partial class Program { }
