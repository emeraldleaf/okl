diff --git a/src/Program.cs b/src/Program.cs
index fed5882..20f64a7 100644
--- a/src/Program.cs
+++ b/src/Program.cs
@@ -17,6 +17,16 @@ app.MapGet("/orders", (HttpContext ctx) =>
     return Results.Ok(Store.Orders.Values.Where(o => o.Owner == user));
 });
 
+app.MapGet("/orders/{id:int}", (int id, HttpContext ctx) =>
+{
+    var user = Auth.CurrentUser(ctx);
+    if (user is null) return Results.Unauthorized();
+    // Ownership predicate is part of the lookup — a match on id alone is not enough.
+    return Store.Orders.TryGetValue(id, out var order) && order.Owner == user
+        ? Results.Ok(order)
+        : Results.NotFound();
+});
+
 app.Run();
 
 public partial class Program { }
