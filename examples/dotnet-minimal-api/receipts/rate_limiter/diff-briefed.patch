+
+public class SearchTests : IClassFixture<WebApplicationFactory<Program>>
+{
+    private readonly WebApplicationFactory<Program> _factory;
+
+    public SearchTests(WebApplicationFactory<Program> factory) => _factory = factory;
+
+    private HttpClient ClientFor(string token)
+    {
+        var client = _factory.CreateClient();
+        client.DefaultRequestHeaders.Add("X-User-Token", token);
+        return client;
+    }
+
+    [Fact]
+    public async Task Search_returns_matching_orders_for_the_caller()
+    {
+        // Arrange: alice owns "widget" (id 1) and "gadget" (id 2); "gadg" only matches gadget
+        var client = ClientFor("token-alice");
+
+        // Act
+        var results = await client.GetFromJsonAsync<List<Order>>("/orders/search?q=gadg");
+
+        // Assert: only order 2 returned; "widget" is not a match
+        Assert.Equal(new[] { 2 }, results!.Select(o => o.Id).ToArray());
+    }
+
+    [Fact]
+    public async Task Search_is_case_insensitive()
+    {
+        // Arrange: uppercase query should match the lowercased item stored in the record
+        var client = ClientFor("token-alice");
+
+        // Act
+        var results = await client.GetFromJsonAsync<List<Order>>("/orders/search?q=WIDGET");
+
+        // Assert: "WIDGET" matches "widget"
+        Assert.Equal(new[] { 1 }, results!.Select(o => o.Id).ToArray());
+    }
+
+    [Fact]
+    public async Task Search_does_not_expose_another_users_orders()
+    {
+        // Arrange: "gizmo" is bob's item — alice must get an empty result, not bob's order (IDOR guard)
+        var client = ClientFor("token-alice");
+
+        // Act
+        var results = await client.GetFromJsonAsync<List<Order>>("/orders/search?q=gizmo");
+
+        // Assert: ownership boundary holds — alice cannot read across it even with a matching query
+        Assert.Empty(results!);
+    }
+
+    [Fact]
+    public async Task Search_returns_401_without_authentication()
+    {
+        // Arrange: request with no auth token
+        var client = _factory.CreateClient();
+
+        // Act
+        var res = await client.GetAsync("/orders/search?q=widget");
+
+        // Assert
+        Assert.Equal(HttpStatusCode.Unauthorized, res.StatusCode);
+    }
+
+    [Fact]
+    public async Task Search_returns_429_after_rate_limit_is_exceeded()
+    {
+        // Arrange: isolated app with a 2-permit window so the test runs in 3 requests, not 31.
+        // UseSetting injects the value into app configuration before Program.cs reads it, so
+        // AddFixedWindowLimiter sees 2 on the first (and only) call — no duplicate-policy error.
+        await using var factory = new WebApplicationFactory<Program>()
+            .WithWebHostBuilder(b => b.UseSetting("RateLimit:SearchPermitLimit", "2"));
+        var client = factory.CreateClient();
+        client.DefaultRequestHeaders.Add("X-User-Token", "token-alice");
+
+        // Act: exhaust the 2-permit budget, then make one more request
+        await client.GetAsync("/orders/search?q=w");
+        await client.GetAsync("/orders/search?q=w");
+        var res = await client.GetAsync("/orders/search?q=w");
+
+        // Assert: third request is rejected — one client cannot monopolise the endpoint
+        Assert.Equal(HttpStatusCode.TooManyRequests, res.StatusCode);
+    }
+}
