 // Two users, a handful of orders, an in-memory store. Nothing here is production code; it
 // exists so an agent can be asked realistic tasks (add an endpoint, add a search) and the
 // briefing can be seen doing its job — or not, in the control run.
+using Microsoft.AspNetCore.RateLimiting;
 using OrdersApi;
 
 var builder = WebApplication.CreateBuilder(args);
+
+// Configurable so tests can tighten the window without sending 30 requests.
+var searchPermitLimit = builder.Configuration.GetValue<int>("RateLimit:SearchPermitLimit", 30);
+builder.Services.AddRateLimiter(options =>
+{
+    options.AddFixedWindowLimiter("search-limit", o =>
+    {
+        o.PermitLimit = searchPermitLimit;
+        o.Window = TimeSpan.FromSeconds(10);
+        o.QueueLimit = 0;
+    });
+    options.RejectionStatusCode = StatusCodes.Status429TooManyRequests;
+});
+
 var app = builder.Build();
+app.UseRateLimiter();
 
 app.MapGet("/health", () => Results.Ok(new { ok = true }));
 
@@ -17,6 +33,18 @@ app.MapGet("/orders", (HttpContext ctx) =>
     return Results.Ok(Store.Orders.Values.Where(o => o.Owner == user));
 });
 
+// Search the caller's own orders by item text, case-insensitive.
+// Rate-limited: a leading-wildcard-style scan on every request can't use an index.
+app.MapGet("/orders/search", (HttpContext ctx, string? q) =>
+{
+    var user = Auth.CurrentUser(ctx);
+    if (user is null) return Results.Unauthorized();
+    if (string.IsNullOrEmpty(q)) return Results.Ok(Array.Empty<Order>());
+    var results = Store.Orders.Values
+        .Where(o => o.Owner == user && o.Item.Contains(q, StringComparison.OrdinalIgnoreCase));
+    return Results.Ok(results);
+}).RequireRateLimiting("search-limit");
+
 app.Run();
 
 public partial class Program { }
