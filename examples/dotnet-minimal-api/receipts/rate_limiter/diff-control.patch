+    [Fact]
+    public async Task Search_orders_filters_by_item_text_case_insensitively()
+    {
+        // alice owns "widget" (1) and "gadget" (2); both contain "get" case-insensitively.
+        // bob's "gizmo" (3) must be excluded even though it also matches the owner check never fires.
+        var req = new HttpRequestMessage(HttpMethod.Get, "/orders/search?q=GET");
+        req.Headers.Add("X-User-Token", "token-alice");
+        var res = await _client.SendAsync(req);
+        var results = await res.Content.ReadFromJsonAsync<List<Order>>();
+        Assert.Equal(new[] { 1, 2 }, results!.Select(o => o.Id).Order().ToArray());
+    }
