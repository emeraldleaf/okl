+class OrderIn(BaseModel):
+    item: str
+    quantity: int
+
+
+@app.post("/orders", status_code=201)
+def create_order(body: OrderIn, user: str = Depends(current_user)) -> dict:
+    unit_price = PRODUCTS.get(body.item)
+    if unit_price is None:
+        raise HTTPException(status_code=422, detail="unknown item")
+    order_id = max(ORDERS) + 1
+    order = {"id": order_id, "owner": user, "item": body.item, "quantity": body.quantity, "unit_price": unit_price}
+    ORDERS[order_id] = order
+    return order
+
