 from fastapi import Depends, FastAPI, Header, HTTPException
+from pydantic import BaseModel
 
 from .store import ORDERS, USERS
 
@@ -22,3 +23,23 @@ def health() -> dict:
 def list_orders(user: str = Depends(current_user)) -> list[dict]:
     """The caller's own orders only."""
     return [o for o in ORDERS.values() if o["owner"] == user]
+
+
+class CreateOrderRequest(BaseModel):
+    item: str
+    quantity: int
+    unit_price: float
+
+
+@app.post("/orders", status_code=201)
+def create_order(body: CreateOrderRequest, user: str = Depends(current_user)) -> dict:
+    next_id = max(ORDERS.keys(), default=0) + 1
+    order = {
+        "id": next_id,
+        "owner": user,
+        "item": body.item,
+        "quantity": body.quantity,
+        "unit_price": body.unit_price,
+    }
+    ORDERS[next_id] = order
+    return order
