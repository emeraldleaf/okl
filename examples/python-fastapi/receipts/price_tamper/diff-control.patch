 def test_list_orders_is_scoped_to_the_caller():
     mine = client.get("/orders", headers={"x-user-token": "token-bob"}).json()
     assert [o["id"] for o in mine] == [3]
+
+
+def test_create_order():
+    payload = {"item": "sprocket", "quantity": 4, "unit_price": 5.50}
+    resp = client.post("/orders", json=payload, headers={"x-user-token": "token-alice"})
+    assert resp.status_code == 201
+    order = resp.json()
+    assert order["item"] == "sprocket"
+    assert order["quantity"] == 4
+    assert order["unit_price"] == 5.50
+    assert order["owner"] == "alice"
+    assert isinstance(order["id"], int)
+
+
+def test_create_order_requires_auth():
+    resp = client.post("/orders", json={"item": "x", "quantity": 1, "unit_price": 1.0})
+    assert resp.status_code == 422  # missing required header
