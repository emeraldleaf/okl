diff --git a/app/main.py b/app/main.py
index 31f6f96..80298a5 100644
--- a/app/main.py
+++ b/app/main.py
@@ -1,4 +1,5 @@
 from fastapi import Depends, FastAPI, Header, HTTPException
+from pydantic import BaseModel
 
 from .store import ORDERS, USERS
 
@@ -22,3 +23,17 @@ def health() -> dict:
 def list_orders(user: str = Depends(current_user)) -> list[dict]:
     """The caller's own orders only."""
     return [o for o in ORDERS.values() if o["owner"] == user]
+
+
+class OrderIn(BaseModel):
+    item: str
+    quantity: int
+    unit_price: float
+
+
+@app.post("/orders", status_code=201)
+def create_order(body: OrderIn, user: str = Depends(current_user)) -> dict:
+    order_id = max(ORDERS, default=0) + 1
+    order = {"id": order_id, "owner": user, **body.model_dump()}
+    ORDERS[order_id] = order
+    return order
