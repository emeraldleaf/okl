diff --git a/tests/test_app.py b/tests/test_app.py
index dbee006..6339bce 100644
--- a/tests/test_app.py
+++ b/tests/test_app.py
@@ -11,3 +11,30 @@ def test_health():
 def test_list_orders_is_scoped_to_the_caller():
     mine = client.get("/orders", headers={"x-user-token": "token-bob"}).json()
     assert [o["id"] for o in mine] == [3]
+
+
+def test_search_orders_returns_matching_items():
+    results = client.get("/orders/search?q=widget", headers={"x-user-token": "token-alice"}).json()
+    assert [o["id"] for o in results] == [1]
+
+
+def test_search_orders_is_case_insensitive():
+    results = client.get("/orders/search?q=GADGET", headers={"x-user-token": "token-alice"}).json()
+    assert [o["id"] for o in results] == [2]
+
+
+def test_search_orders_is_scoped_to_caller():
+    # bob searching "gizmo" should NOT see alice's orders
+    results = client.get("/orders/search?q=gizmo", headers={"x-user-token": "token-bob"}).json()
+    assert all(o["owner"] == "bob" for o in results)
+    assert [o["id"] for o in results] == [3]
+
+
+def test_search_orders_no_match_returns_empty():
+    results = client.get("/orders/search?q=nonexistent", headers={"x-user-token": "token-alice"}).json()
+    assert results == []
+
+
+def test_search_orders_requires_auth():
+    resp = client.get("/orders/search?q=widget")
+    assert resp.status_code == 422
