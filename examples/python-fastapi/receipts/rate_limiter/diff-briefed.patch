+from fastapi import Depends, FastAPI, Header, HTTPException, Query
 
 from .store import ORDERS, USERS
 
 app = FastAPI(title="orders-api")
 
+# Fixed-window policy: 30 req / 10 s per user, no queueing, 429 on reject.
+_SEARCH_LIMIT = 30
+_SEARCH_WINDOW = 10.0
+_rate_counters: dict[str, list[float]] = defaultdict(list)
+
+
+def _search_rate_limit(user: str) -> None:
+    now = time.monotonic()
+    window_start = now - _SEARCH_WINDOW
+    _rate_counters[user] = [t for t in _rate_counters[user] if t > window_start]
+    if len(_rate_counters[user]) >= _SEARCH_LIMIT:
+        raise HTTPException(status_code=429, detail="rate limit exceeded")
+    _rate_counters[user].append(now)
+
 
 def current_user(x_user_token: str = Header(...)) -> str:
     """Resolve the caller from a bearer-like header. Deliberately simple."""
@@ -22,3 +39,16 @@ def health() -> dict:
 def list_orders(user: str = Depends(current_user)) -> list[dict]:
     """The caller's own orders only."""
     return [o for o in ORDERS.values() if o["owner"] == user]
+
+
+@app.get("/orders/search")
+def search_orders(
+    q: str = Query(..., min_length=1),
+    user: str = Depends(current_user),
+) -> list[dict]:
+    _search_rate_limit(user)
+    needle = q.lower()
+    return [
