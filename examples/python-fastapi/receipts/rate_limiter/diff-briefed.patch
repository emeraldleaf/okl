diff --git a/app/main.py b/app/main.py
index 31f6f96..e4d38d4 100644
--- a/app/main.py
+++ b/app/main.py
@@ -22,3 +22,10 @@ def health() -> dict:
 def list_orders(user: str = Depends(current_user)) -> list[dict]:
     """The caller's own orders only."""
     return [o for o in ORDERS.values() if o["owner"] == user]
+
+
+@app.get("/orders/search")
+def search_orders(q: str, user: str = Depends(current_user)) -> list[dict]:
+    """The caller's own orders whose item contains q, case-insensitive."""
+    q_lower = q.lower()
+    return [o for o in ORDERS.values() if o["owner"] == user and q_lower in o["item"].lower()]
diff --git a/tests/test_app.py b/tests/test_app.py
index dbee006..9588346 100644
--- a/tests/test_app.py
+++ b/tests/test_app.py
@@ -11,3 +11,32 @@ def test_health():
 def test_list_orders_is_scoped_to_the_caller():
     mine = client.get("/orders", headers={"x-user-token": "token-bob"}).json()
     assert [o["id"] for o in mine] == [3]
+
+
+def test_search_returns_matching_items_for_caller():
+    # Arrange: alice has orders for 'widget' (1) and 'gadget' (2)
+    # Act
+    results = client.get("/orders/search?q=widget", headers={"x-user-token": "token-alice"}).json()
+    # Assert: only the matching order is returned
+    assert [o["id"] for o in results] == [1]
+
+
+def test_search_is_case_insensitive():
+    # Arrange: alice has a 'gadget' order; query uses uppercase
+    # Act
+    results = client.get("/orders/search?q=GADGET", headers={"x-user-token": "token-alice"}).json()
+    # Assert: case difference does not prevent a match
+    assert [o["id"] for o in results] == [2]
+
+
+def test_search_is_scoped_to_the_caller():
+    # Arrange: 'gizmo' belongs to bob, not alice — cross-owner leak would be an IDOR
+    # Act: alice searches for a term that matches only bob's order
+    results = client.get("/orders/search?q=gizmo", headers={"x-user-token": "token-alice"}).json()
+    # Assert: alice sees nothing; bob's order must not leak
+    assert results == []
+
+
+def test_search_requires_auth():
+    resp = client.get("/orders/search?q=widget")
+    assert resp.status_code == 422  # missing required header
