@@ -22,3 +22,14 @@ def health() -> dict:
 def list_orders(user: str = Depends(current_user)) -> list[dict]:
     """The caller's own orders only."""
     return [o for o in ORDERS.values() if o["owner"] == user]
+
+
+@app.get("/orders/{order_id}")
+def get_order(order_id: int, user: str = Depends(current_user)) -> dict:
+    """Return a single order — only if it belongs to the authenticated caller."""
+    order = ORDERS.get(order_id)
+    if order is None:
+        raise HTTPException(status_code=404, detail="order not found")
+    if order["owner"] != user:
+        raise HTTPException(status_code=403, detail="forbidden")
+    return order
