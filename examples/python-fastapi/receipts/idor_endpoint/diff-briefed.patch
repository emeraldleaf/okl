+
+
+@app.get("/orders/{order_id}")
+def get_order(order_id: int, user: str = Depends(current_user)) -> dict:
+    """Return a single order — 404 if it doesn't exist or belongs to another user."""
+    order = ORDERS.get(order_id)
+    if order is None or order["owner"] != user:
+        raise HTTPException(status_code=404, detail="order not found")
+    return order
