      "seed": 5092,
      "groupIds": [],
      "frameId": null,
      "updated": 1776053089759,
      "link": null,
      "locked": false,
      "text": "the grader is usually `ls`, not an LLM · verify at decision boundaries, not every micro-step · a step saying \"done\" and the work being done are different facts",
      "fontSize": 12.5,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "the grader is usually `ls`, not an LLM · verify at decision boundaries, not every micro-step · a step saying \"done\" and the work being done are different facts",
