      "text": "VERIFICATION — don't let a step grade itself",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "VERIFICATION — don't let a step grade itself",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "vf92",
      "type": "text",
      "x": 560,
      "y": 765,
      "width": 1093.125,
      "height": 18.5,
      "angle": 0,
