#!/usr/bin/env bash
# okl-fingerprint: sha256:e1d5e85c3c4685242f1fbe1ad9da1a3b3486129cea00e8998de025d17983f587
# git pre-push hook, installed by `okl init --git-hook` (#90): run the drift gate before a push.
#
# Blocks the push ONLY when okl ran and found drift (exit 1): a lesson whose governed files
# changed after its last verification. Anything else lets the push through with a warning on
# stderr -- exit 2 (no store, or no lesson governs a file), or okl not runnable at all.
# Blocking on those would stop every push from a clone that has no store yet, and
# uninstalling okl would leave a hook that refuses pushes.
#
# This is an early warning for one clone, not a merge gate: it runs only where it was
# installed, and `git push --no-verify` skips it. On a team, gate drift in CI as well.
set -uo pipefail

# Git runs hooks from the top of the working tree, where .okl/config.json lives. The refs
# being pushed arrive on stdin; drift reads the checked-out history, so they are not read.

# Resolve how to invoke okl (env → pinned config → PATH → python3 -m okl), as the Claude
# Code hooks do: a GUI git client or an IDE runs hooks without the shell's venv/pipx PATH.
runnable() { command -v "${1%% *}" >/dev/null 2>&1; }
OKL=""
resolve_okl() {
  if [ -n "${OKL_BIN:-}" ] && runnable "$OKL_BIN"; then OKL=$OKL_BIN; return 0; fi
  if [ -f .okl/config.json ]; then
    local bin
    bin=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("okl_bin") or "")' \
          .okl/config.json 2>/dev/null || true)
    if [ -n "$bin" ] && runnable "$bin"; then OKL=$bin; return 0; fi
  fi
  if command -v okl >/dev/null 2>&1; then OKL=okl; return 0; fi
  if python3 -c "import okl" >/dev/null 2>&1; then OKL="python3 -m okl"; return 0; fi
  return 1
}

if ! resolve_okl; then
  echo "okl pre-push: DRIFT NOT CHECKED -- okl could not be found (set OKL_BIN, or re-run" >&2
  echo "  'okl init' from a shell where okl works). Pushing anyway." >&2
  exit 0
fi

# $OKL unquoted on purpose: it may be a command + args ("python3 -m okl").
$OKL drift --gate
rc=$?
case "$rc" in
  0) exit 0 ;;
  1) echo "okl pre-push: lessons drifted (above). Re-check them with 'okl reverify', commit," >&2
     echo "  then push again. 'git push --no-verify' skips this check." >&2
     exit 1 ;;
  *) echo "okl pre-push: DRIFT NOT CHECKED (okl exit $rc, reason above). Pushing anyway." >&2
     exit 0 ;;
esac
